[Unit]
Description=Superposition Accounts GraphQL for %i
Requires=superposition-accounts@%i.socket
After=network-online.target superposition-accounts@%i.socket
Wants=network-online.target

[Service]
Type=simple
User=spn_accounts
Group=fluidity_apps
EnvironmentFile=/etc/fluidity-apps/%i.conf
ExecStart=/usr/local/bin/accounts.superposition.so
Restart=on-failure
RestartSec=3s

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
