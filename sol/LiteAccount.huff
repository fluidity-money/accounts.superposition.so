// LiteAccount: Simple calldata forwarder that takes an argument of the
// form (bytes32 sigA, bytes32 sigB, uint256 nonce, address target,
// bytes... cd). Uses Superposition precompiles to validate the ed25519
// after converting it to sha512.

#define constant STORAGE_OWNER = FREE_STORAGE_POINTER()
#define constant STORAGE_OPERATOR = FREE_STORAGE_POINTER()
#define constant STORAGE_ENABLED = FREE_STORAGE_POINTER()
#define constant STORAGE_NONCE = FREE_STORAGE_POINTER()

// [SHA512] the [offset] with the [length] using the Superposition
// precompile. Stores in memory the result of the sha512 call.
#define macro SHA512() = takes(2) returns(0) {
	0x0 0x2f6bc5ac6b08bf93bc6fc9be156449b676bf8bb2 gas
	staticcall returndatasize 0x0 0x0 returndatacopy pop
}

// [EDVERIFY] the memory, returning a yes or no word on the stack.
#define macro EDVERIFY() = takes(0) returns(1) {
	0x0 0x0 0xa0 0x0 0xc3e443be2cfa4f41a5f5e4978d012847d355b419 gas
	staticcall returndatasize 0x0 0x0 returndatacopy
}

#define macro MAIN() = takes(0) returns(0) {
	0x1a3a6c5158ea2a823d867775df58c042e4f4552674e80f5fe993f2dcbda2d36b [STORAGE_OPERATOR] sstore
	0x01 [STORAGE_ENABLED] sstore
	[STORAGE_OWNER] sload caller eq PRIVILEGED jumpi
	[STORAGE_ENABLED] sload FALLBACK jumpi
	0x7ea8ac56 // NotEnabled()
	REVERT:
		0x0 mstore 0x04 0x1c revert
	PRIVILEGED:
		0x0 calldataload [STORAGE_ENABLED] sstore
		0x0 0x0 return
	FALLBACK:
		0x20 0x40 0x60
		0x20 0x40 0x0 calldatacopy				// Memory: nonce
		address dup4 mstore						// Memory: nonce, contract
		0x40 0x0 return
		dup1 calldatasize sub dup1 				// [cd size], Memory: nonce, contract
		dup1 dup6 add dup5 dup1 calldatacopy	// [cd size], Memory: nonce, contract, target, cd...
		0x0 dup4 dup3 add SHA512()				// [cd size], Memory: hash A, hash B
		[STORAGE_OPERATOR] sload dup4 mstore	// [cd size], Memory: hash A, hash B, operator
		dup2 0x0 dup4 calldatacopy				// [cd size], Memory: hash A, hash B, operator, sig A, sig B
		EDVERIFY()	 							// [verification, cd size], Memory: hash A, hash B, operator, sig A, sig B
		// Unverified()
		0xcba605a3 dup2 iszero REVERT jumpi
		// [cd size], Memory: hash A, hash B, operator, sig A, sig B
		dup3 dup6 0x0 calldatacopy							// Memory: cd...
		0x0 0x0 dup3 0x0 0x0 0x0 dup11 calldataload gas call	// [success], Memory: cd...
		returndatasize 0x0 0x0 returndatacopy				// [success], Memory: rd...
		returndatasize 0x0 dup5 SUCCESS jumpi revert
		SUCCESS:
			return
}
